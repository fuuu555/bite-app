# Local development defaults only. Replace secrets in deployment environments.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bitemap:bitemap_local_dev_only@127.0.0.1:5433/bitemap
REDIS_URL=redis://127.0.0.1:6379/0
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
# Google Cloud OAuth client credentials; keep the secret out of Git and deployment logs.
# Production must use HTTPS and register this callback URI in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Development-only MapLibre style. Configure a production tile provider before deployment.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Stage 1 address search and map-click reverse geocoding.
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=BiteMap/0.1 (local development)

POSTGRES_DB=bitemap
POSTGRES_USER=bitemap
POSTGRES_PASSWORD=bitemap_local_dev_only
